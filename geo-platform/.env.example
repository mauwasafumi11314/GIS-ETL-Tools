# Copy to .env and adjust. Never commit the real .env.

# --- Database (used by docker compose to provision Postgres/PostGIS) ---
POSTGRES_DB=geoplatform
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-me

# --- Connection string used by the API and the ETL CLI ---
# Inside docker compose the host is "db"; from your own machine it is "localhost".
DATABASE_URL=postgresql://geo:change-me@localhost:5432/geoplatform

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Vector tiles ---
TILE_EXTENT=4096
TILE_BUFFER=64
TILE_CACHE_SECONDS=300

# --- Limits ---
MAX_FEATURES=5000
